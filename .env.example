# Groq LLM (required from Phase P3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Workspace delivery (required from Phase P5)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
EMAIL_RECIPIENTS=
GOOGLE_DOC_ID=

# MCP Server (Google Workspace integration)
# URL of the running google-mcp-server. Default: http://127.0.0.1:8000
MCP_SERVER_URL=http://127.0.0.1:8000
# Optional API key forwarded as X-API-Key to the MCP server
MCP_API_KEY=
# Per-request timeout in seconds (default 60)
MCP_TIMEOUT_SECONDS=60
# Number of retry attempts on transient network failures (default 3)
MCP_MAX_RETRIES=3

# Pipeline settings
REVIEW_WINDOW_WEEKS=10
DATABASE_PATH=data/review_pulse.db
