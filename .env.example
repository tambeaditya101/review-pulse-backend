# Groq LLM (required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Workspace delivery (required for Google Docs and Gmail delivery)
GOOGLE_DOC_ID=
EMAIL_RECIPIENTS=

# MCP Server (google-mcp-server integration)
# URL of the running google-mcp-server. Default: http://127.0.0.1:8000
MCP_SERVER_URL=http://127.0.0.1:8000
# Optional API key forwarded as X-API-Key to the MCP server
MCP_API_KEY=
# Per-request timeout in seconds (default 60)
MCP_TIMEOUT_SECONDS=60
# Number of retry attempts on transient network failures (default 3)
MCP_MAX_RETRIES=3

# Google OAuth paths (used by google-mcp-server, not by this pipeline directly)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Pipeline settings
REVIEW_WINDOW_WEEKS=10
DATABASE_PATH=data/review_pulse.db

# REST API authentication
# When set, all /api/* endpoints require X-API-Key: <value> in the request header.
# Leave empty to run the API without authentication (local development only).
API_KEY=

# Low-resource mode
# Set to true to use TF-IDF instead of sentence-transformers (reduces RAM usage on Render free tier).
# LOW_RESOURCE_MODE=true
